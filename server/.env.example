# 考公小助手 · 后端环境变量（复制为 .env 后填写，.env 不入库）
# 微信小程序（AppID 见项目根 .env）
WX_APPID=wxafd75651e3f7ddd0
# 微信小程序 AppSecret（微信公众平台 → 开发管理 → 开发设置）
WX_APPSECRET=
# 智能问答上游（GLM-4，Key 仅存服务端，绝不下发客户端）
GLM_API_KEY=
GLM_MODEL=glm-4-flash
# 会话签名密钥（随机长字符串）
SECRET_KEY=
# 数据库（服务器 MySQL；本地开发可用 sqlite:///kaogong.db）
DATABASE_URL=mysql+pymysql://kaogong:CHANGE_ME@127.0.0.1:3306/kaogong?charset=utf8mb4
# 正式用户 OpenID 白名单（逗号分隔；陌生 OpenID 一律 guest 不落库）
USER_WHITELIST=
# B 端管理口令（发放奖励券 / 维护奖池）
ADMIN_TOKEN=
