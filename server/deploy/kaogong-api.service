# systemd 单元：/etc/systemd/system/kaogong-api.service
# 部署目录 /opt/kaogong-api（venv 一并放置），监听 127.0.0.1:8000，由 Nginx /api/ 反代
[Unit]
Description=Kaogong Mini API (FastAPI)
After=network.target docker.service

[Service]
WorkingDirectory=/opt/kaogong-api
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kaogong-api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
